<%- include('layout/header') %>

<div class="container mx-auto px-4 py-8 animate-fadeIn">
    
    <!-- Profile Header -->
    <div class="profile-gradient rounded-2xl shadow-2xl mb-8 overflow-hidden">
        <div class="glass-effect p-8 bg-blue-600/20 backdrop-blur-md">
            <div class="flex flex-col md:flex-row items-center justify-between">
                <div class="flex items-center space-x-6 mb-6 md:mb-0">
                    <!-- Avatar -->
                    <div class="avatar-upload relative">
                        <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-white shadow-xl bg-gray-200 flex items-center justify-center">
                            <i class="fa-solid fa-user text-5xl text-gray-400"></i>
                        </div>
                    </div>
                    
                    <!-- User Info -->
                    <div>
                        <h1 class="text-3xl font-bold text-white mb-2"><%= admin.username %></h1>
                        <div class="flex items-center space-x-4">
                            <span class="px-3 py-1 bg-white/20 text-white rounded-full text-sm font-medium">
                                <i class="fa-solid fa-shield-alt mr-1"></i> <%= admin.role.charAt(0).toUpperCase() + admin.role.slice(1) %>
                            </span>
                            <span class="text-white/80">
                                <i class="fa-solid fa-map-marker-alt mr-1"></i> <%= admin.address || 'No address set' %>
                            </span>
                        </div>
                        <p class="text-white/80 mt-3 max-w-md">
                            Welcome back, <%= admin.username %>! You are managing the BikeHub inventory.
                        </p>
                    </div>
                </div>
                
                <!-- Stats -->
                <div class="grid grid-cols-2 gap-4">
                    <div class="text-center p-4 bg-white/10 rounded-xl backdrop-blur-sm">
                        <div class="text-2xl font-bold text-white"><%= totalBikes %></div>
                        <div class="text-white/80 text-sm">Bikes Managed</div>
                    </div>
                    <div class="text-center p-4 bg-white/10 rounded-xl backdrop-blur-sm">
                        <div class="text-2xl font-bold text-white"><%= totalBrands %></div>
                        <div class="text-white/80 text-sm">Brands</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Tabs Navigation -->
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
                <div class="border-b border-gray-200">
                    <div class="flex space-x-1 p-4">
                        <button class="tab-button flex-1 py-3 px-4 rounded-lg font-medium text-gray-600 hover:bg-gray-50 active-tab transition-all" data-tab="overview">
                            <i class="fa-solid fa-chart-pie mr-2"></i> Overview
                        </button>
                        <button class="tab-button flex-1 py-3 px-4 rounded-lg font-medium text-gray-600 hover:bg-gray-50 transition-all" data-tab="settings">
                            <i class="fa-solid fa-cog mr-2"></i> Settings
                        </button>
                    </div>
                </div>
                
                <!-- Tab Content -->
                <div class="p-6">
                    
                    <!-- Overview Tab -->
                    <div id="overviewTab" class="tab-content space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="p-6 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white shadow-lg">
                                <h4 class="text-lg font-medium opacity-80 mb-2">Total Inventory</h4>
                                <div class="text-4xl font-bold mb-4"><%= totalBikes %> Bikes</div>
                                <div class="flex items-center text-sm opacity-90">
                                    <i class="fa-solid fa-circle-check mr-2"></i> Active and tracking
                                </div>
                            </div>
                            <div class="p-6 rounded-xl bg-gradient-to-br from-purple-500 to-pink-600 text-white shadow-lg">
                                <h4 class="text-lg font-medium opacity-80 mb-2">Brands Covered</h4>
                                <div class="text-4xl font-bold mb-4"><%= totalBrands %> Brands</div>
                                <div class="flex items-center text-sm opacity-90">
                                    <i class="fa-solid fa-tags mr-2"></i> Across all categories
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
                            <h3 class="text-xl font-bold text-gray-800 mb-4">Account Information</h3>
                            <div class="space-y-4">
                                <div class="flex justify-between py-2 border-b border-gray-200">
                                    <span class="text-gray-600">Username</span>
                                    <span class="font-medium text-gray-800"><%= admin.username %></span>
                                </div>
                                <div class="flex justify-between py-2 border-b border-gray-200">
                                    <span class="text-gray-600">Phone Number</span>
                                    <span class="font-medium text-gray-800"><%= admin.phone_number || 'Not provided' %></span>
                                </div>
                                <div class="flex justify-between py-2 border-b border-gray-200">
                                    <span class="text-gray-600">Address</span>
                                    <span class="font-medium text-gray-800"><%= admin.address || 'Not provided' %></span>
                                </div>
                                <div class="flex justify-between py-2">
                                    <span class="text-gray-600">Role</span>
                                    <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-sm font-bold"><%= admin.role.toUpperCase() %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Settings Tab -->
                    <div id="settingsTab" class="tab-content hidden space-y-6">
                        <form id="profileForm" class="space-y-6">
                            <h3 class="text-xl font-bold text-gray-800">Update Profile</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                                    <input type="tel" name="phone_number" value="<%= admin.phone_number %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition duration-200">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Address</label>
                                    <input type="text" name="address" value="<%= admin.address %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition duration-200">
                                </div>
                            </div>
                            <button type="submit" class="px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-md">
                                Update Information
                            </button>
                        </form>

                        <div class="border-t border-gray-200 pt-8">
                            <form id="passwordForm" class="space-y-6">
                                <h3 class="text-xl font-bold text-gray-800">Change Password</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                                        <input type="password" name="newPassword" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition duration-200">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Confirm New Password</label>
                                        <input type="password" name="confirmPassword" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition duration-200">
                                    </div>
                                </div>
                                <button type="submit" class="px-8 py-3 bg-gray-800 text-white font-semibold rounded-lg hover:bg-gray-900 transition-all shadow-md">
                                    Change Password
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Column -->
        <div class="space-y-8">
            <!-- Quick Actions -->
            <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
                <h3 class="text-xl font-bold text-gray-800 mb-6">Quick Actions</h3>
                <div class="space-y-3">
                    <a href="/add-vehicle" class="flex items-center justify-between p-4 bg-blue-50 rounded-xl hover:bg-blue-100 transition-all group">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center">
                                <i class="fa-solid fa-plus text-white"></i>
                            </div>
                            <div class="font-bold text-gray-800">Add New Bike</div>
                        </div>
                        <i class="fa-solid fa-arrow-right text-blue-400 group-hover:translate-x-1 transition-transform"></i>
                    </a>
                    
                    <a href="/add-model" class="flex items-center justify-between p-4 bg-green-50 rounded-xl hover:bg-green-100 transition-all group">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-lg bg-green-600 flex items-center justify-center">
                                <i class="fa-solid fa-tag text-white"></i>
                            </div>
                            <div class="font-bold text-gray-800">Add Brand</div>
                        </div>
                        <i class="fa-solid fa-arrow-right text-green-400 group-hover:translate-x-1 transition-transform"></i>
                    </a>
                </div>
            </div>

            <!-- Danger Zone -->
            <div class="bg-red-50 rounded-2xl shadow-lg p-6 border border-red-100">
                <h3 class="text-xl font-bold text-red-800 mb-4">Danger Zone</h3>
                <p class="text-sm text-red-600 mb-6">Deleteting your account will permanently remove all your data. This action is irreversible.</p>
                <button onclick="confirmDeleteAccount()" class="w-full px-4 py-3 bg-red-600 text-white font-bold rounded-lg hover:bg-red-700 transition-all">
                    Delete Account
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-gradient {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    }
    .active-tab {
        background: #3b82f6 !important;
        color: white !important;
    }
    .animate-fadeIn {
        animation: fadeIn 0.5s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    // Tab Switching
    document.querySelectorAll('.tab-button').forEach(button => {
        button.addEventListener('click', function() {
            const tabId = this.getAttribute('data-tab');
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active-tab'));
            this.classList.add('active-tab');
            
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
            document.getElementById(`${tabId}Tab`).classList.remove('hidden');
        });
    });

    // Handle Profile Form
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('/api/profile', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (response.ok) {
                showToast(result.message, 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(result.message || 'Error updating profile', 'error');
            }
        } catch (err) {
            showToast('Network error', 'error');
        }
    });

    // Handle Password Form
    document.getElementById('passwordForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        if (data.newPassword !== data.confirmPassword) {
            return showToast('Passwords do not match', 'error');
        }

        try {
            const response = await fetch('/api/password', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newPassword: data.newPassword })
            });
            const result = await response.json();
            if (response.ok) {
                showToast('Password updated successfully', 'success');
                e.target.reset();
            } else {
                showToast(result.message || 'Error updating password', 'error');
            }
        } catch (err) {
            showToast('Network error', 'error');
        }
    });

    function confirmDeleteAccount() {
        if (confirm('Are you absolutely sure? This will delete your account forever.')) {
            fetch('/api/delete', { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    if (data.message.includes('success')) window.location.href = '/login';
                });
        }
    }
</script>

<%- include('layout/footer') %>